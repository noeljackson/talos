; Compile-time checks on the EFFECTIVE policy after macro/attribute expansion.
; These protect specific runtime boundaries, not a blanket host-access claim:
; any_p still has self BPF operations and pod_p still has any_f execute.

; mdadm may replace its dedicated runtime map, not remove generic /run names.
; Ordinary pods retain baseline getattr/search, not mdadm state access.
(neverallow udev_t run_t (dir (remove_name)))
(neverallow pod_t mdadm_run_t (dir (create read open write add_name remove_name)))
(neverallow pod_t mdadm_run_t (file (create read open write lock rename unlink)))

; Ordinary pods cannot read or modify Cilium's dedicated host runtime state.
; Generic getattr/search remain part of the upstream traversal baseline.
(neverallow pod_t cilium_runtime_t (file (read open write create unlink)))
(neverallow pod_t cilium_runtime_t (dir (read open write add_name remove_name)))
(neverallow pod_t cilium_runtime_t (sock_file (write)))
(neverallow pod_t bpf_t (file (write create unlink)))
(neverallow pod_t bpf_t (dir (write add_name remove_name)))
(neverallow pod_t self (perf_event (all)))
(neverallow pod_t init_t (file (read open)))
(neverallow pod_t sandboxd_t (file (read open)))

; This intersection must stay empty. Every process can fork itself, so the
; assertion fails if these constrained domains acquire MCS exemption, even
; indirectly through an attribute.
(typeattribute unexpected_mcs_exempt_p)
(typeattribute mcs_constrained_runtime_p)
(typeattributeset mcs_constrained_runtime_p (pod_t node_exporter_t sandboxd_t))
(typeattributeset unexpected_mcs_exempt_p (and mcs_exempt_p mcs_constrained_runtime_p))
(neverallow unexpected_mcs_exempt_p self (process (fork)))

; Host observers read metadata but cannot control PID 1 or mutate its files.
(typeattribute runtime_observer_p)
(typeattributeset runtime_observer_p (falco_t node_exporter_t))
(neverallow runtime_observer_p init_t (file (write)))
(neverallow runtime_observer_p init_t (process (ptrace signal sigkill transition)))
(neverallow falco_t tracefs_t (file (write create relabelfrom relabelto)))
(neverallow falco_t debugfs_t (file (read open)))
(neverallow runtime_observer_p sys_containerd_socket_t (sock_file (write)))
(neverallow runtime_observer_p sys_containerd_t (unix_stream_socket (connectto)))
(neverallow runtime_observer_p machine_socket_t (sock_file (write)))
(neverallow runtime_observer_p init_t (unix_stream_socket (connectto)))

; Kata may enter through its finite host-helper label, not arbitrary host tools.
; Do not turn this into an execute/execute_no_trans denial: those are inherited.
(neverallow pod_t bin_exec_t (file (entrypoint)))

; Only extension services get immutable extension executable/library rights.
(typeattribute non_extension_system_container_p)
(typeattributeset non_extension_system_container_p (and system_container_p (not extension_service_p)))
(neverallow non_extension_system_container_p bin_exec_t (file (entrypoint execute execute_no_trans)))
(neverallow non_extension_system_container_p lib_t (file (execute)))
(neverallow unconfined_container_t sysfs_t (file (write)))

; sandboxd launches services inside the workload namespace; it must not gain
; machined's machine-management capabilities. Existing service_p/common grants
; still permit host reads and ordinary device access, so no broader claim is made.
(neverallow sandboxd_t init_t (process (transition ptrace signal sigkill)))
(neverallow sandboxd_t self (capability (sys_boot sys_module)))
(neverallow sandboxd_t module_t (system (module_load)))
(neverallow sandboxd_t tmpfs_t (system (kexec_image_load kexec_initramfs_load)))
(neverallow sandboxd_t machine_socket_t (sock_file (write)))
(neverallow sandboxd_t init_t (unix_stream_socket (connectto)))
(neverallow sandboxd_t efivarfs_t (file (write)))

; The kernel's static usermode helper (services/usermodehelper.cil) is reachable
; from containers through request_module. Only the kernel enters it; it enters
; no other domain, writes no module or root file, holds no capability but
; sys_module and dac_override, and opens no socket but the unix one it connects
; to machined with.
(typeattribute not_kernel_p)
(typeattributeset not_kernel_p (not kernel_t))
(typeattribute any_type_p)
(typeattributeset any_type_p (all))
(typeattribute not_init_p)
(typeattributeset not_init_p (not init_t))
(neverallow not_kernel_p usermodehelper_t (process (transition dyntransition)))
(neverallow usermodehelper_t any_type_p (process (transition dyntransition)))
(typeattribute not_init_exec_p)
(typeattributeset not_init_exec_p (not init_exec_t))
(neverallow usermodehelper_t not_init_exec_p (file (entrypoint)))
(neverallow usermodehelper_t any_type_p (file (execute_no_trans)))
(neverallow usermodehelper_t self (capability (not (sys_module dac_override))))
(neverallow usermodehelper_t self (cap_userns (all)))
(neverallow usermodehelper_t module_t (file (write append create unlink rename setattr relabelfrom relabelto)))
(neverallow usermodehelper_t module_t (dir (write add_name remove_name create rmdir rename reparent setattr relabelfrom relabelto)))
(neverallow usermodehelper_t sys_module_t (file (write append create unlink rename setattr relabelfrom relabelto)))
(neverallow usermodehelper_t sys_module_t (dir (write add_name remove_name create rmdir rename reparent setattr relabelfrom relabelto)))
(neverallow usermodehelper_t rootfs_t (file (write append create unlink rename setattr relabelfrom relabelto)))
(neverallow usermodehelper_t rootfs_t (dir (write add_name remove_name create rmdir rename reparent setattr relabelfrom relabelto)))
(neverallow usermodehelper_t not_init_p (unix_stream_socket (connectto)))
(neverallow usermodehelper_t any_type_p (unix_dgram_socket (all)))
(neverallow usermodehelper_t any_type_p (alg_socket (all)))
(neverallow usermodehelper_t any_type_p (appletalk_socket (all)))
(neverallow usermodehelper_t any_type_p (atmpvc_socket (all)))
(neverallow usermodehelper_t any_type_p (atmsvc_socket (all)))
(neverallow usermodehelper_t any_type_p (ax25_socket (all)))
(neverallow usermodehelper_t any_type_p (bluetooth_socket (all)))
(neverallow usermodehelper_t any_type_p (caif_socket (all)))
(neverallow usermodehelper_t any_type_p (can_socket (all)))
(neverallow usermodehelper_t any_type_p (dccp_socket (all)))
(neverallow usermodehelper_t any_type_p (decnet_socket (all)))
(neverallow usermodehelper_t any_type_p (icmp_socket (all)))
(neverallow usermodehelper_t any_type_p (ieee802154_socket (all)))
(neverallow usermodehelper_t any_type_p (ipx_socket (all)))
(neverallow usermodehelper_t any_type_p (irda_socket (all)))
(neverallow usermodehelper_t any_type_p (isdn_socket (all)))
(neverallow usermodehelper_t any_type_p (iucv_socket (all)))
(neverallow usermodehelper_t any_type_p (kcm_socket (all)))
(neverallow usermodehelper_t any_type_p (key_socket (all)))
(neverallow usermodehelper_t any_type_p (llc_socket (all)))
(neverallow usermodehelper_t any_type_p (mctp_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_audit_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_connector_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_crypto_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_dnrt_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_fib_lookup_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_generic_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_iscsi_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_kobject_uevent_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_netfilter_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_nflog_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_rdma_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_route_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_scsitransport_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_selinux_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_tcpdiag_socket (all)))
(neverallow usermodehelper_t any_type_p (netlink_xfrm_socket (all)))
(neverallow usermodehelper_t any_type_p (netrom_socket (all)))
(neverallow usermodehelper_t any_type_p (nfc_socket (all)))
(neverallow usermodehelper_t any_type_p (obsolete_netlink_firewall_socket (all)))
(neverallow usermodehelper_t any_type_p (obsolete_netlink_ip6fw_socket (all)))
(neverallow usermodehelper_t any_type_p (packet_socket (all)))
(neverallow usermodehelper_t any_type_p (phonet_socket (all)))
(neverallow usermodehelper_t any_type_p (pppox_socket (all)))
(neverallow usermodehelper_t any_type_p (qipcrtr_socket (all)))
(neverallow usermodehelper_t any_type_p (rawip_socket (all)))
(neverallow usermodehelper_t any_type_p (rds_socket (all)))
(neverallow usermodehelper_t any_type_p (rose_socket (all)))
(neverallow usermodehelper_t any_type_p (rxrpc_socket (all)))
(neverallow usermodehelper_t any_type_p (sctp_socket (all)))
(neverallow usermodehelper_t any_type_p (smc_socket (all)))
(neverallow usermodehelper_t any_type_p (socket (all)))
(neverallow usermodehelper_t any_type_p (tcp_socket (all)))
(neverallow usermodehelper_t any_type_p (tipc_socket (all)))
(neverallow usermodehelper_t any_type_p (tun_socket (all)))
(neverallow usermodehelper_t any_type_p (udp_socket (all)))
(neverallow usermodehelper_t any_type_p (vsock_socket (all)))
(neverallow usermodehelper_t any_type_p (x25_socket (all)))
(neverallow usermodehelper_t any_type_p (xdp_socket (all)))

; The CRI containerd never sets the scheduling of a kernel thread; the loop
; worker's denial is only kept out of the log (services/cri.cil).
(neverallow pod_containerd_t kernel_t (process (setsched)))
