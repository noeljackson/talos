; Pod (CRI) containerd
(type pod_containerd_t)
(call service_p (pod_containerd_t containerd_exec_t))
; CRI containerd allocates MCS categories and must supervise the labeled pod
; roots and processes it creates. Pod domains themselves remain constrained.
(typeattributeset mcs_exempt_p pod_containerd_t)

(type pod_containerd_socket_t)
(call system_socket_f (pod_containerd_socket_t))
; Shim and client sockets
(allow pod_containerd_t run_t (fs_classes (rw)))
(typeattribute not_pod_containerd_socket_t)
(typeattributeset not_pod_containerd_socket_t (not pod_containerd_socket_t))
(typetransition pod_containerd_t not_pod_containerd_socket_t sock_file pod_containerd_socket_t)

(type pod_containerd_run_t)
(call system_f (pod_containerd_run_t))
(allow pod_containerd_run_t tmpfs_t (filesystem (associate)))

(typetransition pod_containerd_t run_t file pod_containerd_run_t)
(typetransition pod_containerd_t run_t dir pod_containerd_run_t)
(typetransition pod_containerd_t run_t lnk_file pod_containerd_run_t)
(typetransition pod_containerd_t run_t chr_file pod_containerd_run_t)
(typetransition pod_containerd_t run_t blk_file pod_containerd_run_t)
(typetransition pod_containerd_t run_t fifo_file pod_containerd_run_t)

(allow pod_containerd_t pod_containerd_run_t (fs_classes (rw)))

; Cilium uses a shared host runtime directory for agent state and Envoy
; sockets. It is created by machined before CRI, so it does not inherit the
; pod-containerd runtime label used for shim-created paths.
(type cilium_runtime_t)
(call system_f (cilium_runtime_t))
(allow cilium_runtime_t tmpfs_t (filesystem (associate)))
(allow pod_containerd_t cilium_runtime_t (fs_classes (rw)))

; Transition to pod contexts
(allow pod_containerd_t pod_p (process2 (nnp_transition nosuid_transition)))
(allow pod_containerd_t pod_p (process (transition)))

; Containerd storage
(allow pod_containerd_t containerd_state_t (fs_classes (rw)))
(allow pod_containerd_t containerd_state_t (file (entrypoint execute execute_no_trans)))
(allow pod_containerd_t containerd_state_t (fs_classes (relabelto relabelfrom)))
; CRI supplies a per-pod mount context when SELinux handling is enabled. The
; root overlay, /dev tmpfs, and /dev/pts devpts superblocks and their mountpoint
; objects start in their native domains. runc relabels both the superblock and
; mountpoint to the configured ephemeral context.
; Its proc and sysfs mounts deliberately omit the mount label, while mqueue is
; mounted unlabeled and labels only its mountpoint, so no other filesystem
; domains belong in this relabel contract.
(allow pod_containerd_t fs_t (fs_classes (relabelfrom)))
(allow pod_containerd_t tmpfs_t (fs_classes (relabelfrom)))
(allow pod_containerd_t devpts_t (fs_classes (relabelfrom)))
(allow pod_containerd_t ephemeral_t (fs_classes (relabelfrom relabelto)))
(allow ephemeral_t tmpfs_t (filesystem (associate)))
(allow ephemeral_t devpts_t (filesystem (associate)))

; Manage procfs & processes
(allow pod_containerd_t pod_p (fs_classes (rw)))
(allow pod_containerd_t pod_p (process_classes (full)))
(allow pod_p pod_containerd_t (fd (use)))
(allow pod_p pod_containerd_t (fifo_file (append getattr ioctl map open read rename setattr watch write)))

; CNI
(allow pod_containerd_t cni_plugin_t (file (execute_no_trans execute)))
(allow pod_containerd_t cni_plugin_t (fs_classes (ro)))
; iptables used by CNI
(allow pod_containerd_t bin_exec_t (file (execute_no_trans execute)))
(allow pod_containerd_t bin_exec_t (fs_classes (ro)))
; (allow pod_p cni_conf_t (fs_classes (rw)))
(allow pod_containerd_t cni_state_t (fs_classes (rw)))

; Logs
(allow pod_containerd_t pods_log_t (fs_classes (rw)))

(allow pod_containerd_t pod_p (key (view read write search link setattr create)))

; Shim socket
(allow pod_containerd_t pod_containerd_socket_t (fs_classes (rw)))

; CRI proxy snapshotters and storage helpers run as Talos extension services.
; Their socket inodes remain governed by the separately labeled /run filesystem
; objects; allow only the Unix peer connection required after that path check.
(allow pod_containerd_t extension_service_p (unix_stream_socket (connectto)))

; System containers, not k8s pods

(type etcd_t)
(call pod_p (etcd_t))
; FIXME: insecure as anyone with access to the pod containerd may obtain this domain
(allow etcd_t containerd_state_t (file (entrypoint)))

(type etcd_pki_t)
(call protected_f (etcd_pki_t))
(allow etcd_pki_t tmpfs_t (filesystem (associate)))
(allow etcd_t etcd_pki_t (fs_classes (ro)))

(type etcd_data_t)
(call protected_f (etcd_data_t))
(allow etcd_t etcd_data_t (fs_classes (rw)))

(type cni_conf_t)
(call filesystem_f (cni_conf_t))
(filecon "/etc/cni(/.*)?" any (system_u object_r cni_conf_t (systemLow systemLow)))

(type cni_plugin_t)
(call filesystem_f (cni_plugin_t))
(filecon "/opt/cni(/.*)?" any (system_u object_r cni_plugin_t (systemLow systemLow)))

(type containerd_plugin_t)
(call filesystem_f (containerd_plugin_t))
(filecon "/opt/containerd(/.*)?" any (system_u object_r containerd_plugin_t (systemLow systemLow)))

(type containerd_state_t)
(call common_f (containerd_state_t))

(type kube_apiserver_config_t)
(call protected_f (kube_apiserver_config_t))
(allow kube_apiserver_config_t tmpfs_t (filesystem (associate)))
(type kube_scheduler_config_t)
(call protected_f (kube_scheduler_config_t))
(allow kube_scheduler_config_t tmpfs_t (filesystem (associate)))
(type kube_apiserver_secret_t)
(call protected_f (kube_apiserver_secret_t))
(allow kube_apiserver_secret_t tmpfs_t (filesystem (associate)))
(type kube_controller_manager_secret_t)
(call protected_f (kube_controller_manager_secret_t))
(allow kube_controller_manager_secret_t tmpfs_t (filesystem (associate)))
(type kube_scheduler_secret_t)
(call protected_f (kube_scheduler_secret_t))
(allow kube_scheduler_secret_t tmpfs_t (filesystem (associate)))

(typeattribute kube_secret_f)
(typeattributeset kube_secret_f kube_apiserver_config_t)
(typeattributeset kube_secret_f kube_scheduler_config_t)
(typeattributeset kube_secret_f kube_apiserver_secret_t)
(typeattributeset kube_secret_f kube_controller_manager_secret_t)
(typeattributeset kube_secret_f kube_scheduler_secret_t)

; Allow kubernetes pods to access their configuration and secrets
; FIXME: insecure as anyone with access to the pod containerd may obtain these domains
; TODO: label static pods with the correct domains
(allow pod_p kube_secret_f (fs_classes (ro)))

(type var_log_t)
(call protected_f (var_log_t))
(type audit_log_t)
(call protected_f (audit_log_t))
(type containers_log_t)
(call protected_f (containers_log_t))
(type pods_log_t)
(call protected_f (pods_log_t))
(type var_lock_t)
(call protected_f (var_lock_t))
(allow var_lock_t tmpfs_t (filesystem (associate)))
(type iscsi_lock_t)
(call protected_f (iscsi_lock_t))
(allow iscsi_lock_t tmpfs_t (filesystem (associate)))
(filecon "/run/lock/iscsi(/.*)?" any (system_u object_r iscsi_lock_t (systemLow systemLow)))

; Talos creates /run/lock/iscsi before CRI starts. Open-iSCSI then uses two
; fixed entries: it opens or creates "lock", hard-links it to "lock.write" to
; acquire the database lock, and unlinks "lock.write" to release it. Keep this
; lifecycle on a dedicated object type instead of granting either containerd
; domain write access to the shared var_lock_t tree.
(allow pod_containerd_t iscsi_lock_t (dir (add_name getattr remove_name search write)))
(allow pod_containerd_t iscsi_lock_t (file (create getattr link open read unlink write)))
(allow extension_service_p iscsi_lock_t (dir (add_name getattr remove_name search write)))
(allow extension_service_p iscsi_lock_t (file (create getattr link open read unlink write)))
(type seccomp_profile_t)
(call protected_f (seccomp_profile_t))
(type kube_log_t)
(call protected_f (kube_log_t))

(typeattribute log_f)
(typeattributeset log_f var_log_t)
(typeattributeset log_f audit_log_t)
(typeattributeset log_f containers_log_t)
(typeattributeset log_f pods_log_t)
(typeattributeset log_f var_lock_t)
(typeattributeset log_f seccomp_profile_t)
(typeattributeset log_f kube_log_t)

; FIXME: insecure as anyone with access to the pod containerd may obtain these domains
; TODO: label static pods with the correct domains
(allow pod_p log_f (fs_classes (rw)))

(type cni_state_t)
(call protected_f (cni_state_t))

; All pods

; local-path-provisioner
(allow pod_containerd_t ephemeral_t (fs_classes (rw)))
(allow pod_p ephemeral_t (fs_classes (rw)))

; userns mode
; https://github.com/containerd/containerd/blob/9b552d441582d71b7fd322c0b9f2c7c23b26b729/pkg/sys/unshare_linux.go#L59
; https://github.com/containerd/containerd/blob/9b552d441582d71b7fd322c0b9f2c7c23b26b729/core/mount/mount_idmapped_utils_linux.go#L51
(allow pod_containerd_t self (process (ptrace)))
(allow pod_containerd_t self (user_namespace (create)))

; Manage pseudo-terminals for containers, Kubernetes Conformance needs this
(allow pod_containerd_t devpts_t (fs_classes (rw)))
(allow pod_p devpts_t (fs_classes (rw)))

; Kata's CRI shim remains in the MCS-exempt pod_containerd_t domain while the
; VMM runs under the sandbox pod_p label. Allow only the Unix stream peer
; connection used by the shim to reach the VMM API socket; access to the
; socket inode remains governed by the separately typed filesystem rules.
(allow pod_containerd_t pod_p (unix_stream_socket (connectto)))

; Opening an existing named TAP invokes Linux's selinux_tun_dev_open hook.
; The hook relabels the TUN security SID to the caller and therefore checks
; both relabelfrom and relabelto even when both SIDs are pod_containerd_t.
; Keep this exception on the CRI shim's own TUN sockets; the shared network
; policy continues to exclude relabel permissions from every other domain.
(allow pod_containerd_t self (tun_socket (relabelfrom relabelto)))

; pkg/flannel
(allow pod_p cni_conf_t (fs_classes (rw)))

; Common rules for containerd accessing system
(typeattributeset containerd_p pod_containerd_t)

(type pod_t)
(call pod_p (pod_t))

; containerd deliberately clears the requested SELinux process label for a
; privileged CRI sandbox. Trusted privileged node agents such as Longhorn
; therefore inherit pod_containerd_t while walking the host /proc tree.
; Give that domain read-only process-metadata traversal, but no process,
; ptrace, signal, write, relabel, or generic host-filesystem access.
(allow pod_containerd_t any_p (dir (getattr open read search)))
(allow pod_containerd_t any_p (file (getattr open read)))
(allow pod_containerd_t any_p (lnk_file (getattr read)))

; Longhorn V1's privileged instance manager also inherits pod_containerd_t.
; After an iSCSI login it sets the SCSI command timeout through the dynamic
; /sys/block/<device>/device/timeout path. The backing sysfs inode path varies
; with each SCSI session and sysfs exposes it only as sysfs_t, so it cannot be
; assigned a stable path-specific type. Permit only the observed write checks;
; do not grant generic sysfs rw, creation, setattr, or relabel permissions.
(allow pod_containerd_t sysfs_t (dir (write)))
(allow pod_containerd_t sysfs_t (file (write)))

; node-exporter is not privileged, so keep its host-observer access out of the
; generic pod_t domain. The workload selects this type explicitly and receives
; only read-only access to Talos PID 1 process metadata and udev's block-device
; records. The ordinary pod domains retain neither permission.
(type node_exporter_t)
(call pod_p (node_exporter_t))
(allow node_exporter_t init_t (dir (getattr open read search)))
(allow node_exporter_t init_t (file (getattr open read)))
(allow node_exporter_t init_t (lnk_file (getattr read)))
(allow node_exporter_t udev_run_t (file (getattr open read)))

; Falco uses the modern eBPF driver with the chart's least-privileged
; capability set. Keep it out of privileged pod_containerd_t so its host
; observer contract has a dedicated, explicitly selected domain. Falco reads
; process metadata across all MCS categories, owns only its own BPF perf events,
; reads the host tracefs IDs required to attach its modern eBPF tracepoints, and
; queries the pod containerd CRI socket for the container metadata required by
; its rules. The chart exposes only the tracefs mount and that socket on Talos
; workers. Keep both targets exact: Falco receives no other socket I/O, host-
; process control, filesystem write, ptrace, relabel, or generic host-filesystem
; permission here.
(type falco_t)
(call pod_p (falco_t))
(typeattributeset mcs_exempt_p falco_t)
(allow falco_t any_p (dir (getattr open read search)))
(allow falco_t any_p (file (getattr open read)))
(allow falco_t any_p (lnk_file (getattr read)))
(allow falco_t any_p (unix_stream_socket (getattr)))
(allow falco_t any_p (unix_dgram_socket (getattr)))
(allow falco_t any_p (fifo_file (getattr)))
(allow falco_t self (perf_event (all)))
(allow falco_t tracefs_t (dir (getattr open read search)))
(allow falco_t tracefs_t (file (getattr open read)))
(allow falco_t pod_containerd_socket_t (sock_file (write)))
(allow falco_t pod_containerd_t (unix_stream_socket (connectto)))

; Kata's host-side hypervisor helpers are launched by the CRI shim after it
; requests the sandbox's pod_t process label. A privileged sandbox has no pod
; process label and the helpers instead inherit pod_containerd_t. Keep both
; execution paths separate from generic bin_exec_t: sandboxes may execute only
; these finite immutable extension binaries, not arbitrary host utilities.
(type kata_helper_exec_t)
(call system_f (kata_helper_exec_t))
(context kata_helper_exec_t (system_u object_r kata_helper_exec_t (systemLow systemLow)))
(filecon "/usr/local/bin/cloud-hypervisor" file kata_helper_exec_t)
(filecon "/usr/local/bin/qemu-system-x86_64-snp-experimental" file kata_helper_exec_t)
(filecon "/usr/local/libexec/qemu-system-x86_64-snp-experimental" file kata_helper_exec_t)
(filecon "/usr/local/libexec/virtiofsd" file kata_helper_exec_t)
(allow pod_containerd_t kata_helper_exec_t (fs_classes (ro)))
(allow pod_containerd_t kata_helper_exec_t (file (execute_no_trans execute)))
(allow pod_t kata_helper_exec_t (fs_classes (ro)))
(allow pod_t kata_helper_exec_t (file (entrypoint execute)))

; Kata VMMs open the immutable guest kernel, root image, CoCo initrd, and QEMU
; firmware directly. QEMU selects machine firmware and option ROMs from its
; dedicated packaged data directory, so label every regular file in that
; immutable directory rather than maintaining a filename allowlist. Keep these
; boot artifacts separate from generic usr_t so the sandbox cannot read
; arbitrary host files under /usr.
(type kata_guest_image_t)
(call system_f (kata_guest_image_t))
(context kata_guest_image_t (system_u object_r kata_guest_image_t (systemLow systemLow)))
(filecon "/usr/local/share/kata-containers/kata-containers-coco-extension.img" file kata_guest_image_t)
(filecon "/usr/local/share/kata-containers/kata-containers-confidential.img" file kata_guest_image_t)
(filecon "/usr/local/share/kata-containers/kata-containers.img" file kata_guest_image_t)
(filecon "/usr/local/share/kata-containers/vmlinux.container" file kata_guest_image_t)
(filecon "/usr/local/share/kata-containers/vmlinuz.container" file kata_guest_image_t)
(filecon "/usr/local/share/kata-containers/vmlinuz-[0-9]+([.][0-9]+)*-[0-9]+" file kata_guest_image_t)
(filecon "/usr/local/share/kata-qemu-snp-experimental/qemu/.*" file kata_guest_image_t)
(filecon "/usr/local/share/ovmf/AMDSEV.fd" file kata_guest_image_t)
(allow pod_t kata_guest_image_t (file (read open lock)))

; Kata applies the sandbox's MCS-scoped pod_t label to the VMM and virtiofsd
; for an ordinary sandbox. A privileged sandbox has no pod process label, so
; its VMM remains in pod_containerd_t. The ordinary VMM inspects, creates, and
; listens on its shim-owned QMP stream, and removes the shim-created QMP socket
; inode before binding its listener. Both execution paths create an io_uring
; instance. Permit only those observed startup edges for the concrete domains;
; do not broaden the pod_p attribute, generic filesystem classes, or either
; socket class.
(allow pod_t pod_containerd_t (unix_stream_socket (read write accept connectto getattr getopt listen)))
(allow pod_t init_t (unix_dgram_socket (sendto)))
(allow pod_t rootfs_t (dir (read open mounton)))
(allow pod_t pod_containerd_socket_t (sock_file (write unlink)))
(allow pod_t self (io_uring (allowed)))
(allow pod_containerd_t self (io_uring (allowed)))

(type cilium_t)
(call pod_p (cilium_t))
; Cilium is a node agent, not an isolated tenant workload. It intentionally
; keeps one stable s0 domain while reading Kubernetes-projected configuration
; and owning persistent CNI, BPF, and runtime host paths across pod restarts.
; Exempt only this dedicated type from MCS category comparison; the ordinary
; pod domains remain isolated and every object access still needs a type allow.
(typeattributeset mcs_exempt_p cilium_t)
; Only the Cilium agent and Envoy use this shared hostPath. Do not grant all
; pod domains access to generic /run or pod-containerd runtime paths.
(allow cilium_t cilium_runtime_t (fs_classes (rw)))
; Cilium's install-cni-binaries init container populates Talos's dedicated CNI
; binary tree before the agent starts.
(allow cilium_t cni_plugin_t (fs_classes (rw)))
; Talos mounts bpffs. Cilium owns its maps, programs, and perf-event readers,
; but it does not receive generic host-namespace or /run access.
(allow cilium_t bpf_t (fs_classes (rw)))
(allow cilium_t self (perf_event (all)))
(allow cilium_t containerd_p (bpf (prog_run)))
(allow pod_containerd_t cilium_t (unix_stream_socket (connectto)))
; The Cilium agent enumerates the standard host /run/netns directory to enter
; pod network namespaces. It does not need write access to generic /run.
(allow cilium_t run_t (dir (getattr open read search)))
(typeattribute not_containerd_exec_t)
(typeattributeset not_containerd_exec_t (not containerd_exec_t))
; Keep the runc helper in pod_containerd_t. CRI's explicit process label moves
; only the container entrypoint into a pod domain with the same MCS categories
; as its rootfs. An automatic transition on either snapshot label would move
; runc itself to pod_t at systemLow before it can apply that exact label.
(allow pod_p containerd_state_t (fs_classes (rw)))
(allow pod_p containerd_state_t (file (entrypoint execute execute_no_trans)))
; With a CRI mount label, executable files in the pod rootfs are ephemeral_t
; instead of containerd_state_t. Permit the same bounded entry transition from
; that labeled rootfs; the requested process label still selects specialized
; pod domains such as cilium_t.
(allow pod_containerd_t ephemeral_t (file (execute execute_no_trans)))
(allow pod_p ephemeral_t (file (entrypoint execute)))

; ; allow configuring CNI
; (allow pod_p cni_conf_t (fs_classes (rw)))

; ; CNI plugins access netns
; (allow pod_p nsfs_t (fs_classes (rw)))

; Flannel calls modprobe
(allow pod_p module_t (fs_classes (ro)))

; emptyDir volumes, used e.g. by hydrophone cts
; TODO: label
(allow pod_p kubelet_state_t (fs_classes (rw)))

; getattr, unmount called by containers and should be guarded by their mount namespaces
(allow pod_p fs_t (filesystem (
    ; associate
    getattr
    mount
    quotaget
    quotamod
    ; relabelfrom
    ; relabelto
    remount
    unmount
    watch
)))

; Calico and basically any CNI installing plugins
(allow pod_t cni_plugin_t (fs_classes (rw)))
; `install` also seems to test the plugin
(allow pod_t cni_plugin_t (file (execute execute_no_trans)))

; TinK is an example of what needs this. Docker in a pod will also require this.
(allow pod_p cgroup_t (fs_classes (rw)))
(allow pod_p nsfs_t (fs_classes (ro)))
(allow pod_p self (key (all)))
(allow pod_p self (capability2 (syslog)))
(allow pod_p procfs_t (filesystem (mount remount unmount)))
(allow pod_p kernel_t (system (syslog_read)))
; Mainly ephemeral, but basically run anything without transitioning
(allow pod_p any_f (file (execute execute_no_trans)))
; /sys/firmware
(allow pod_p sysfs_t (filesystem (mount remount unmount)))
(allow pod_p sysfs_t (fs_classes (mounton)))
; TinK
(allow pod_p sysfs_t (filesystem (mount remount unmount)))
(allow pod_p nsfs_t (filesystem (mount remount unmount)))
(allow pod_p devpts_t (filesystem (mount remount unmount)))
; /proc/bus
(allow pod_p procfs_t (filesystem (mount remount unmount)))
(allow pod_p procfs_t (fs_classes (mounton)))
; module params (used e.g. by containerd)
(allow pod_p sys_module_t (fs_classes (ro)))

; TinK
; [  110.873621] audit: type=1400 audit(1742647858.928:213): avc:  denied  { relabelfrom } for  pid=4732 comm="containerd" name="etc" dev="vda4" ino=122484 scontext=system_u:system_r:pod_t:s0 tcontext=system_u:object_r:ephemeral_t:s0 tclass=dir permissive=1
; [  110.875762] audit: type=1400 audit(1742647858.928:213): avc:  denied  { relabelto } for  pid=4732 comm="containerd" name="etc" dev="vda4" ino=122484 scontext=system_u:system_r:pod_t:s0 tcontext=system_u:object_r:ephemeral_t:s0 tclass=dir permissive=1
(allow pod_p ephemeral_t (fs_classes (relabelfrom relabelto)))

; CRI containerd should talk machined API to call machine.ImageService/Verify API
(allow pod_containerd_t machine_socket_t (fs_classes (rw)))
(allow pod_containerd_t init_t (unix_stream_socket (connectto)))
; Kata shim v2 always connects to the host syslog socket while loading its
; runtime configuration. Talos syslogd owns /dev/log in init_t, so allow only
; Unix-datagram delivery from the CRI containerd domain to that service.
(allow pod_containerd_t init_t (unix_dgram_socket (sendto)))
